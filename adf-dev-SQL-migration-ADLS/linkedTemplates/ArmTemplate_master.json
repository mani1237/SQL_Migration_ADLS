{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dev-SQL-migration-ADLS"
		},
		"LS_SQLServer_SRC_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLServer_SRC'"
		},
		"LS_SQL_Retail_Tables_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_Retail_Tables'"
		},
		"LS_ADLS_Retail_Parq_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_Retail_Parq'"
		},
		"LS_SQLServer_SRC_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "Mani37-Laptop\\SQLEXPRESS"
		},
		"LS_SQLServer_SRC_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQL_Migration_ADF"
		},
		"LS_SQLServer_SRC_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ADF_Practice_Login"
		},
		"LS_SQL_Retail_Tables_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "Mani37-Laptop\\SQLEXPRESS"
		},
		"LS_SQL_Retail_Tables_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SQL_MIGRATION_ADF"
		},
		"LS_SQL_Retail_Tables_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ADF_Practice_Login"
		},
		"LS_ADLS_Retail_Parq_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlssqlmigrationsink.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-dev-SQL-migration-ADLS_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Retail_Parq_accountKey": {
						"value": "[parameters('LS_ADLS_Retail_Parq_accountKey')]"
					},
					"LS_SQLServer_SRC_password": {
						"value": "[parameters('LS_SQLServer_SRC_password')]"
					},
					"LS_SQL_Retail_Tables_password": {
						"value": "[parameters('LS_SQL_Retail_Tables_password')]"
					},
					"LS_ADLS_Retail_Parq_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Retail_Parq_properties_typeProperties_url')]"
					},
					"LS_SQLServer_SRC_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLServer_SRC_properties_typeProperties_server')]"
					},
					"LS_SQLServer_SRC_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLServer_SRC_properties_typeProperties_database')]"
					},
					"LS_SQLServer_SRC_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLServer_SRC_properties_typeProperties_userName')]"
					},
					"LS_SQL_Retail_Tables_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_Retail_Tables_properties_typeProperties_server')]"
					},
					"LS_SQL_Retail_Tables_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_Retail_Tables_properties_typeProperties_database')]"
					},
					"LS_SQL_Retail_Tables_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_Retail_Tables_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}