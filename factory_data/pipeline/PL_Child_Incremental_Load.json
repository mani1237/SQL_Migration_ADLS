{
	"name": "PL_Child_Incremental_Load",
	"properties": {
		"activities": [
			{
				"name": "CPY_SQL_Full_Incremental_Load",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'SELECT * FROM ',\n    pipeline().parameters.TableSchema,'.',pipeline().parameters.TableName,\n    if(\n        equals(pipeline().parameters.LastLoadValue,null),\n        '',\n        concat(' Where ',pipeline().parameters.WatermarkColumn,\n        ' > ',pipeline().parameters.LastLoadValue\n        )\n    )\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "FlattenHierarchy"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_LKP_Max_Value",
						"type": "DatasetReference",
						"parameters": {
							"TableSchema": {
								"value": "@pipeline().parameters.TableSchema",
								"type": "Expression"
							},
							"TableName": {
								"value": "@pipeline().parameters.TableName",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Retail_parque",
						"type": "DatasetReference",
						"parameters": {
							"TableName": {
								"value": "@pipeline().parameters.TableName",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Exec_Pipeline_Update_WaterMark",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "CPY_SQL_Full_Incremental_Load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Child_Watermark_StoreProcedure",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"TableSchema": {
							"value": "@pipeline().parameters.TableSchema",
							"type": "Expression"
						},
						"TableName": {
							"value": "@pipeline().parameters.TableName",
							"type": "Expression"
						},
						"WatermarkColumn": {
							"value": "@pipeline().parameters.WatermarkColumn",
							"type": "Expression"
						}
					}
				}
			}
		],
		"parameters": {
			"TableSchema": {
				"type": "string"
			},
			"TableName": {
				"type": "string"
			},
			"WatermarkColumn": {
				"type": "string"
			},
			"LastLoadValue": {
				"type": "string"
			}
		},
		"annotations": []
	}
}